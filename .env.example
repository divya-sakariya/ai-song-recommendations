# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai-song-recommendations

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret

# Google OAuth (AUTH-01)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini — mood analysis / captions (ANALYSIS-01, PRD 6/8.6).
# Without this set, mood analysis runs in a heuristic fallback/demo mode
# instead of calling the live model — see lib/ai/moodAnalysis.ts.
GEMINI_API_KEY=

# Spotify Web API — client-credentials flow (app-only auth, no user login
# needed for catalog search). Without these set, song search/shortlist
# falls back to a small local catalog — see lib/music/spotify.ts.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 — used as the alternate-platform link for region-locked
# Spotify results (SHORTLIST-05) and as a search fallback. Without this set,
# YouTube links fall back to a plain search-URL (no metadata lookup).
YOUTUBE_API_KEY=
